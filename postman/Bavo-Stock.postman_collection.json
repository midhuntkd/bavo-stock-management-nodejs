{
  "info": {
    "name": "Bavo Stock API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@example.com\",\n  \"password\": \"Admin@123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Permissions - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/permissions"
      }
    },
    {
      "name": "Warehouses - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Main Warehouse\",\n  \"code\": \"WH001\",\n  \"address\": \"Address Line\",\n  \"city\": \"City\",\n  \"state\": \"State\",\n  \"country\": \"Country\",\n  \"pincode\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/warehouses"
      }
    },
    {
      "name": "Stocks - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "Sample Product", "type": "text" },
            { "key": "hsnCode", "value": "HSN1001", "type": "text" },
            { "key": "barcode", "value": "8900000000012", "type": "text" },
            { "key": "salePrice", "value": "120", "type": "text" },
            { "key": "gst", "value": "18", "type": "text" },
            { "key": "mrp", "value": "150", "type": "text" },
            { "key": "actualPrice", "value": "100", "type": "text" },
            { "key": "sku", "value": "SKU-1001", "type": "text" },
            { "key": "warehouseId", "value": "{{warehouseId}}", "type": "text" },
            { "key": "quantity", "value": "100", "type": "text" },
            { "key": "reservedQuantity", "value": "0", "type": "text" },
            { "key": "minimumStockLevel", "value": "10", "type": "text" },
            { "key": "unit", "value": "pcs", "type": "text" },
            { "key": "status", "value": "active", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": "{{baseUrl}}/stocks"
      }
    },
    {
      "name": "Stocks - Update",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "salePrice", "value": "125", "type": "text" },
            { "key": "gst", "value": "18", "type": "text" },
            { "key": "mrp", "value": "160", "type": "text" },
            { "key": "actualPrice", "value": "105", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": "{{baseUrl}}/stocks/{{stockId}}"
      }
    },
    {
      "name": "Stocks - Transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceStockId\": \"{{sourceStockId}}\",\n  \"targetWarehouseId\": \"{{targetWarehouseId}}\",\n  \"quantity\": 5,\n  \"referenceType\": \"manual\"\n}"
        },
        "url": "{{baseUrl}}/stocks/transfer"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "stockId", "value": "" },
    { "key": "sourceStockId", "value": "" },
    { "key": "targetWarehouseId", "value": "" }
  ]
}
