NODE_ENV=development
PORT=4000

APP_NAME=Bavo Stock
APP_BASE_URL=http://localhost:4000

MONGODB_URI=mongodb://127.0.0.1:27017/bavo_stock

JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_PHONE=9999999999

DEFAULT_TIMEZONE=UTC
ALLOW_NEGATIVE_STOCK=false
DEFAULT_PAGINATION_LIMIT=20
MAX_PAGINATION_LIMIT=500

LOG_LEVEL=info

CORS_ORIGIN=*
ENABLE_DOCS=true

RESERVATION_DEFAULT_EXPIRY_MINUTES=30
INVOICE_PREFIX=INV
PO_PREFIX=PO
GRN_PREFIX=GRN
TRANSFER_PREFIX=TRN
ADJUSTMENT_PREFIX=ADJ
ACCOUNT_CODE_PREFIX=ACC
INVESTMENT_PREFIX=INVST
REIMBURSEMENT_PREFIX=RMB

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

